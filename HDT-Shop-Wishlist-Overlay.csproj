<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>HDTShopWishlist</RootNamespace>
    <AssemblyName>HDT-Shop-Wishlist-Overlay</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <InformationalVersion>0.31.0</InformationalVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <HDT_PATH>$(MSBuildProjectDirectory)\deps\HearthstoneDeckTracker.exe</HDT_PATH>
    <HEARTHDB_PATH>$(MSBuildProjectDirectory)\deps\HearthDb.dll</HEARTHDB_PATH>
    <SCRY_PATH>$(MSBuildProjectDirectory)\deps\untapped-scry-dotnet.dll</SCRY_PATH>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\BGCompBuilderIcon.png" />
    <None Include="Assets\BGCompBuilderIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\TribeIcons\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\RarityGlow\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="HearthstoneDeckTracker">
      <HintPath>$(HDT_PATH)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="HearthDb">
      <HintPath>$(HEARTHDB_PATH)</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="untapped-scry-dotnet">
      <HintPath>$(SCRY_PATH)</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>
  <Target Name="CheckHdtReference" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(HDT_PATH)')" Text="Local dependency HearthstoneDeckTracker.exe is missing at '$(HDT_PATH)'. Run build-and-install-v14.bat to populate deps\." />
    <Error Condition="!Exists('$(HEARTHDB_PATH)')" Text="Local dependency HearthDb.dll is missing at '$(HEARTHDB_PATH)'. Run build-and-install-v14.bat to populate deps\." />
    <Error Condition="!Exists('$(SCRY_PATH)')" Text="Local dependency untapped-scry-dotnet.dll is missing at '$(SCRY_PATH)'." />
  </Target>
</Project>
